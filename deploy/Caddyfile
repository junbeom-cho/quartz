# ==== Quartz ==============================================================
@quartz host wiki.techbara.dev

handle @quartz {
	root * /srv/wiki
	encode zstd gzip

	@hashed path_regexp hashed -[0-9a-f]{8}\.(css|js)$
	header @hashed {
		match status 2xx 304
		Cache-Control "public, max-age=31536000, immutable"
	}
	header ?Cache-Control "public, no-cache"

	# rsync 임시 폴더(.~tmp~) 같은 점 경로는 숨김
	@dotfiles path_regexp dotfiles /\.
	handle @dotfiles {
		error 404
	}

	handle {
		# 실제로 있는 .html 파일은 확장자 없는 주소로 308. 대상을 절대 URL로 고정해 open redirect를 막음
		# 사이트 폴더에 직접 넣은 네이버 소유확인 파일(naver<코드>.html)은 리다이렉트하면 확인에 실패하므로 그 주소에서 그대로 응답
		@htmlindex {
			path_regexp htmlindex ^(/(?:.*/)?)index\.html$
			file
		}
		redir @htmlindex https://wiki.techbara.dev{re.htmlindex.1}{?query} 308
		@html {
			path_regexp html ^(/.+)\.html$
			not path /404.html */index.html /naver*.html
			file
		}
		redir @html https://wiki.techbara.dev{re.html.1}{?query} 308

		try_files {path} {path}.html {path}/ =404
		error /404.html 404
		file_server
	}
}

handle_errors 404 {
	handle @quartz {
		# 에러 응답에는 사이트 보안 헤더가 붙지 않으므로 다시 붙임
		import security
		header Cache-Control "no-store"
		# 조건부·Range 요청에도 404 페이지 전체를 보냄
		request_header -If-*
		request_header -Range
		root * /srv/wiki
		rewrite * /404.html
		encode zstd gzip
		file_server
	}
}
